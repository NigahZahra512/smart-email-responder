      "name": "Text Classifier",
      "retryOnFail": true,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer name: {{ $('Gmail Trigger').item.json.From }}\nEmail subject: {{ $('Gmail Trigger').item.json.Subject }}\nEmail content: {{ $('Gmail Trigger').item.json.snippet }}\n\nWrite a reply to this order-related email.",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a professional customer support assistant for Cognisol AI. You write email replies for customers who contacted us about an ORDER (new order, payment, shipping, delivery, tracking, cancellation, return or change).  Rules: - Be polite, clear and professional. Keep the reply between 60 and 120 words. - Reply in the same language as the customer's email. - Acknowledge the customer's order-related request and tell them our team is looking into it. - NEVER invent order numbers, prices, delivery dates, tracking details or policies. If a detail is not in the email, say our team will confirm it shortly. - If the customer's name is available, greet them by name. Otherwise use \"Hello\". - Sign off as \"Cognisol AI Support Team\". - Return ONLY the email body text. Do not include a subject line."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
