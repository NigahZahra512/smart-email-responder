        "categories": {
          "categories": [
            {
              "category": "Order",
              "description": "Emails related to a customer's order. This includes new order confirmations, order placed notifications, payment confirmation for an order, shipping or delivery updates, order status or tracking requests, and requests to cancel, return or change an existing order."
            },
            {
              "category": "Inquiry",
              "description": "Emails where a person is asking a question or seeking information. This includes questions about products, services, prices, availability, features, business hours, or any general enquiry that is not about an existing order."
            }
          ]
        },
        "options": {
          "fallback": "other"
        }
